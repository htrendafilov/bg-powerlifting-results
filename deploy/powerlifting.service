[Unit]
Description=Bulgarian powerlifting results
After=network.target

[Service]
User=hridi
Group=hridi
WorkingDirectory=/home/hridi/bg-powerlifting-results
Environment=DEBUG=0
Environment=ALLOWED_HOSTS=triboy.bg,www.triboy.bg
EnvironmentFile=-/home/hridi/bg-powerlifting-results/.env
ExecStart=/home/hridi/bg-powerlifting-results/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8090 --workers 2
Restart=on-failure

[Install]
WantedBy=multi-user.target
